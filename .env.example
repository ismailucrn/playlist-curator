# Local SQLite database. Relative paths are resolved from prisma/.
DATABASE_URL="file:./dev.db"

# Public origin. Spotify requires an explicit loopback IP for local callbacks.
APP_URL="http://127.0.0.1:3000"

# Demo mode remains available even when Spotify is not configured.
DEMO_MODE="true"

# Create these in Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/auth/spotify/callback"

# 32 random bytes encoded as base64. Required when Spotify OAuth is enabled.
TOKEN_ENCRYPTION_KEY=""

# At least 32 random characters. Used to sign transient OAuth values.
SESSION_SECRET="change-me-in-production-with-at-least-32-characters"
